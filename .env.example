# Copy to .env and fill in. Never commit .env.
# Local dev default (matches docker-compose.yml):
DATABASE_URL=postgresql://referaly:referaly@localhost:5432/referaly

# Better Auth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me-with-a-random-32-byte-secret
# Public base URL of the app (used for auth callbacks/emails).
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — OPTIONAL. Leave blank to run on email/password only.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (see README "Enabling Google OAuth"). The app detects these automatically.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps Platform.
# GOOGLE_MAPS_API_KEY is the SERVER-SIDE key: Geocoding API (db:geocode) and
# Places API (New) (db:enrich-reviews). Restrict it by IP in Cloud Console.
# NEVER expose this key to the browser.
GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY is the PUBLIC browser key for the Maps JavaScript
# API used by the map on the directory page. Restrict it by HTTP referrer.
# If unset, the directory shows a "map unavailable" fallback instead of a map.
VITE_GOOGLE_MAPS_API_KEY=

# Dev server port (npm run dev defaults to 3000 via vite flag).
PORT=3000
